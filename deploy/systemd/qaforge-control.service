[Unit]
Description=Governed QA Forge private control API
After=network.target

[Service]
Type=simple
User=qaforge-control
Group=qaforge-broker
WorkingDirectory=/var/lib/qaforge/workspace
EnvironmentFile=/etc/qaforge/qaforge-control.env
ExecStart=/opt/qaforge/.venv/bin/qaforge serve-control /var/lib/qaforge/workspace --database /var/lib/qaforge/workspace/.service/service.sqlite3 --host 127.0.0.1 --port 8412
Restart=on-failure
RestartSec=3s
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/qaforge/workspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
